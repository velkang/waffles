{
  "$schema": "../node_modules/wrangler/config-schema.json", "name": "waffles-web", "main": "worker.ts", "compatibility_date": "2026-10-28",
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*", "/health*", "/token/*"] },
  "services": [{ "binding": "API", "service": "waffles-api" }], "observability": { "enabled": true }
}
