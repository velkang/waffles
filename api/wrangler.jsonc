{
  "$schema": "../node_modules/wrangler/config-schema.json", "name": "waffles-api", "main": "src/index.ts", "compatibility_date": "2026-10-28", "compatibility_flags": ["nodejs_compat"],
  "vars": {"PROGRAM_ID": "6SpQkgcbZjbrz94pYuWDy5nmBo3czhDGxft1uTvSUR8w", "GENESIS_HASH": "EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG", "UPGRADE_AUTHORITY": "4aMAd4MWzmusUqyGJijr7rF4vaEjxXTLRiBbPdRYxFV7", "MEDIA_ORIGIN": "https://waffles-web.velikanghost.workers.dev", "ACCESS_TEAM": "", "ACCESS_AUD": ""},
  "d1_databases": [{"binding": "DB", "database_name": "waffles-devnet", "database_id": "b442ac40-cced-4b4a-9ed5-703af9a3e6d0", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "ARTIFACTS", "bucket_name": "waffles-devnet"}],
  "services": [{"binding": "JOBS", "service": "waffles-jobs"}],
  "durable_objects": {"bindings": [{"name": "LIVE", "class_name": "LiveHub"}, {"name": "RPC", "class_name": "RpcBudget", "script_name": "waffles-jobs"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LiveHub"]}],
  "ratelimits": [{"name": "RPC_LIMIT", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}}, {"name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}}],
  "observability": {"enabled": true}
}
