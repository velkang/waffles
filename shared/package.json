{
  "name": "@waffles/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./solana": "./src/solana.ts",
    "./rewards": "./src/rewards.ts",
    "./client": "./src/client.ts",
    "./idl": "./src/waffles-idl.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --import tsx --test src/*.test.ts",
    "test:validator": "node --import tsx test/program.integration.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
